// Функция для проверки, является ли номер билета "счастливым" 
int isLuckyTicket(int number) {
    std::string num_str = std::to_string(number);
    while (num_str.length() < 6) {
        num_str = "0" + num_str;
    }
    int sum_first = 0;
    for (int i = 0; i < 3; ++i) {
        sum_first += (num_str[i] - '0');
    }
    int sum_last = 0;
    for (int i = 3; i < 6; ++i) {
        sum_last += (num_str[i] - '0');
    }
    return (sum_first == sum_last) ? 1 : 0;
}

// Тесты
TEST(isLuckyTicketTest, OrdinaryNumbers) { //проверка на разных 6-ти значных значениях
    EXPECT_EQ(isLuckyTicket(123123), 1) << "Number 123123";
    EXPECT_EQ(isLuckyTicket(111111), 1) << "Number 111111";
    EXPECT_EQ(isLuckyTicket(123456), 0) << "Number 123456";
    EXPECT_EQ(isLuckyTicket(123321), 1) << "Number 123321";
}

TEST(isLuckyTicketTest, ShortNumbers) { //проверка на числах короче 6 знаков
    EXPECT_EQ(isLuckyTicket(123), 0) << "Number 123";
    EXPECT_EQ(isLuckyTicket(1230), 0) << "Number 1230";
    EXPECT_EQ(isLuckyTicket(1001), 1) << "Number 1001";
}

TEST(isLuckyTicketTest, EdgeCases) { //проверка граничных значений
    EXPECT_EQ(isLuckyTicket(0), 1) << "Number 0";
    EXPECT_EQ(isLuckyTicket(999999), 1) << "Number 999999";
}



